<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by launchd/install.sh, which fills in __REPO__ and __PYTHON__. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__REPO__/workflows/daily_search/run.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <!-- 19:00 daily. If the Mac is asleep then, launchd runs it on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <!-- Also at login, to catch a 19:00 missed while shut down. run.py's
         guard skips it if a run already succeeded since the last 19:00. -->
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StandardOutPath</key>
    <string>__REPO__/workflows/daily_search/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/workflows/daily_search/logs/launchd.err.log</string>
</dict>
</plist>
